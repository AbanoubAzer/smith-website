@media (max-width: 960px) {
  .contact-layout {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .form-row {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  // Client-side submission helper
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const waBtn = document.getElementById('send-wa-inquiry-btn');
  const emailBtn = document.getElementById('send-email-inquiry-btn');

  // معالجة منتج محدد قادم من صفحات المنتجات ?product=
  const urlParams = new URLSearchParams(window.location.search);
  const selectedProduct = urlParams.get('product');
  if (selectedProduct) {
    const productSelect = document.getElementById('product-service') as HTMLSelectElement | null;
    const messageField = document.getElementById('message') as HTMLTextAreaElement | null;
    if (productSelect) {
      let matched = false;
      for (let i = 0; i < productSelect.options.length; i++) {
        const optText = productSelect.options[i].text.toLowerCase();
        const pLower = selectedProduct.toLowerCase();
        if (pLower.includes(optText) || optText.includes(pLower)) {
          productSelect.selectedIndex = i;
          matched = true;
          break;
        }
      }
      if (!matched) {
        const customOpt = document.createElement('option');
        customOpt.value = selectedProduct;
        customOpt.text = `الموديل المطلوب: ${selectedProduct}`;
        customOpt.selected = true;
        productSelect.appendChild(customOpt);
      }
    }
    if (messageField && !messageField.value) {
      messageField.value = `مرحباً، أود الاستفسار عن المواصفات الهندسية، المقاسات المتاحة، وعرض الأسعار للموديل: ${selectedProduct}.`;
    }
  }

  function getFormData() {
    if (!form) return null;
    const data = new FormData(form);
    return {
      fullName: (data.get('fullName') as string) || '',
      companyName: (data.get('companyName') as string) || '',
      email: (data.get('email') as string) || '',
      phone: (data.get('phone') as string) || '',
      country: (data.get('country') as string) || '',
      productService: (data.get('productService') as string) || '',
      quantity: (data.get('quantity') as string) || '',
      projectLocation: (data.get('projectLocation') as string) || '',
      message: (data.get('message') as string) || '',
    };
  }

  function validateRequired(d: ReturnType<typeof getFormData>): boolean {
    if (!d) return false;
    if (!d.fullName.trim() || !d.phone.trim() || !d.country.trim() || !d.productService || !d.message.trim()) {
      alert('يرجى ملء كافة الحقول الإلزامية (*) قبل الإرسال.');
      return false;
    }
    return true;
  }

  waBtn?.addEventListener('click', () => {
    const d = getFormData();
    if (!validateRequired(d)) return;
    if (!d) return;

    const text = `*طلب عرض سعر واستشارة جديدة (EITCO Ltd)*%0A%0A` +
      `*الاسم:* ${encodeURIComponent(d.fullName)}%0A` +
      (d.companyName ? `*الشركة:* ${encodeURIComponent(d.companyName)}%0A` : '') +
      (d.email ? `*البريد:* ${encodeURIComponent(d.email)}%0A` : '') +
      `*الهاتف:* ${encodeURIComponent(d.phone)}%0A` +
      `*الدولة:* ${encodeURIComponent(d.country)}%0A` +
      `*المنتج/الخدمة:* ${encodeURIComponent(d.productService)}%0A` +
      (d.quantity ? `*الكمية التقديرية:* ${encodeURIComponent(d.quantity)}%0A` : '') +
      (d.projectLocation ? `*موقع المشروع:* ${encodeURIComponent(d.projectLocation)}%0A` : '') +
      `*المواصفات والرسالة:*%0A${encodeURIComponent(d.message)}`;

    window.open(`https://wa.me/8618616232842?text=${text}`, '_blank');
  });

  emailBtn?.addEventListener('click', () => {
    const d = getFormData();
    if (!validateRequired(d)) return;
    if (!d) return;

    const subject = encodeURIComponent(`طلب استفسار: ${d.productService} - ${d.fullName}`);
    const body = encodeURIComponent(
      `طلب عرض سعر جديد (EITCO Ltd):\n\n` +
      `الاسم: ${d.fullName}\n` +
      `الشركة: ${d.companyName || 'N/A'}\n` +
      `البريد: ${d.email || 'N/A'}\n` +
      `الهاتف: ${d.phone}\n` +
      `الدولة: ${d.country}\n` +
      `المنتج / الخدمة: ${d.productService}\n` +
      `الكمية: ${d.quantity || 'N/A'}\n` +
      `الموقع: ${d.projectLocation || 'N/A'}\n\n` +
      `الرسالة والمواصفات:\n${d.message}`
    );

    window.location.href = `mailto:eliagadallah@eit-co.com?subject=${subject}&body=${body}`;
  });
</script>
