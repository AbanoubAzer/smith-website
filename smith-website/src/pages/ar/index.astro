---
// src/pages/ar/index.astro — Arabic Home Page
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLang } from '../../i18n/translations';
import { url } from '../../utils/paths';

const lang = 'ar';
const t = getLang(lang);
const h = t.home;

const heroSlides = [
  {
    img: url('/images/doors/entrance door.jpg'),
    alt: 'أبواب مداخل فاخرة',
    tagline: 'شريكك العالمي في',
    headline: 'أبواب المداخل الفاخرة والحلول المعمارية',
    desc: 'نربط مواد البناء عالية الجودة والمنتجات المعمارية بالعملاء والمقاولين والمطورين والشركات في الولايات المتحدة والأسواق الدولية.',
  },
  {
    img: url('/images/windows/1.jpg'),
    alt: 'نوافذ ألومنيوم فاخرة',
    tagline: 'هندسة متطورة وعزل مثالي',
    headline: 'نوافذ ألومنيوم وأنظمة واجهات متطورة',
    desc: 'حلول نوافذ ألومنيوم عالية الأداء وعازلة للحرارة مصممة للمشاريع السكنية والتجارية الحديثة بأعلى معايير الجودة العالمية.',
  },
  {
    img: url('/images/metalwork/full-facade.png'),
    alt: 'أعمال الحديد المطروق',
    tagline: 'حرفية يدوية وتصاميم مميزة',
    headline: 'أعمال الحديد المطروق والبوابات الفاخرة',
    desc: 'بوابات حديدية مصنعة خصيصاً، درابزينات معمارية فاخرة، وتفاصيل معدنية تضيف طابعاً من الفخامة لكل واجهة ومشروع.',
  },
  {
    img: url('/images/kitchens/Kitchen 1.png'),
    alt: 'خزائن مطبخ مخصصة',
    tagline: 'أناقة التصميم الداخلي',
    headline: 'مطابخ وخزائن مصممة خصيصاً لمساحتك',
    desc: 'خزائن مطبخ عصرية وكلاسيكية، أسطح رخام وكوارتز متقنة، وحلول تخزين وتصميم داخلي متكاملة تناسب أرقى المساحات.',
  },
  {
    img: url('/images/marble/M 1.jpg'),
    alt: 'رخام وأحجار فاخرة',
    tagline: 'فخامة الأحجار الطبيعية',
    headline: 'رخام وأحجار طبيعية مستوردة مباشرة',
    desc: 'توريد مباشر من أفضل المحاجر العالمية للرخام والجرانيت والكوارتز لتلبية متطلبات المشاريع المعمارية الراقية والفلل الفخمة.',
  },
];
---

<Base
  lang={lang}
  title="SMITH Co. LTD — منتجات معمارية وحلول تجارة دولية"
  description="نربط مواد البناء عالية الجودة والمنتجات المعمارية بالعملاء في الولايات المتحدة والأسواق الدولية. أبواب، نوافذ، مطابخ، رخام، والمزيد."
  canonicalUrl="https://smithcoltd.com/ar/"
>
  <Header lang={lang} />

  <!-- HERO -->
  <section class="hero" aria-label="القسم الرئيسي">
    <div class="hero-slider">
      {heroSlides.map((slide, i) => (
        <div class={`hero-slide${i === 0 ? ' active' : ''}`}>
          <img src={slide.img} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <div class="hero-overlay"></div>

    <!-- Navigation Arrows -->
    <button class="hero-arrow hero-arrow-prev" id="hero-prev-btn" aria-label="الشريحة السابقة">
      <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
    </button>
    <button class="hero-arrow hero-arrow-next" id="hero-next-btn" aria-label="الشريحة التالية">
      <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
    </button>

    <div class="container">
      <div class="hero-content">
        <div class="hero-text-slides">
          {heroSlides.map((slide, i) => (
            <div class={`hero-text-slide${i === 0 ? ' active' : ''}`} data-index={i}>
              <p class="hero-tagline">{slide.tagline}</p>
              <h1 class="hero-title">{slide.headline}</h1>
              <p class="hero-desc">{slide.desc}</p>
            </div>
          ))}
        </div>
        <div class="hero-ctas">
          <a href={url('/products/')} class="btn-primary" id="hero-explore-btn-ar">
            {h.hero.cta1} ←
          </a>
          <a href={url('/contact/')} class="btn-outline" id="hero-quote-btn-ar">
            {h.hero.cta2}
          </a>
        </div>
      </div>
    </div>
    <div class="hero-dots">
      {heroSlides.map((_, i) => (
        <button class={`hero-dot${i === 0 ? ' active' : ''}`} aria-label={`شريحة ${i + 1}`} />
      ))}
    </div>
  </section>

  <!-- FEATURES BAR -->
  <section class="features-bar" aria-label="الميزات الرئيسية">
    <div class="container">
      <div class="features-grid">
        {h.features.items.map((feat, i) => (
          <div class="feature-item" id={`feature-ar-${i}`}>
            <span class="feature-icon">{feat.icon}</span>
            <div class="feature-title">{feat.title}</div>
            <div class="feature-desc">{feat.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS SHOWCASE -->
  <section class="products-section" aria-labelledby="products-heading-ar">
    <div class="container">
      <div class="products-layout">
        <div class="products-sidebar">
          <span class="section-tag">{h.products.tag}</span>
          <h2 id="products-heading-ar">{h.products.title}</h2>
          <p>{h.products.desc}</p>
          <a href={url('/products/')} class="btn-secondary" id="view-all-products-btn-ar">
            {h.products.viewAll} ←
          </a>
        </div>
        <div class="products-grid">
          {h.products.categories.map((cat, i) => (
            <a href={url(cat.href)} class="product-card" id={`product-card-ar-${i}`} aria-label={cat.title}>
              <img src={url(cat.img)} alt={cat.title} loading="lazy" />
              <div class="product-card-overlay">
                <div class="product-card-title">
                  {cat.title}
                  <span class="arrow">←</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- GLOBAL SOURCING + PRESENCE -->
  <section class="sourcing-section" aria-labelledby="sourcing-heading-ar">
    <div class="sourcing-layout">
      <div class="sourcing-image">
        <img src={url('/images/metalwork/gate-1.jpg')} alt="شحن دولي" loading="lazy" />
      </div>
      <div class="sourcing-content">
        <span class="section-tag">{h.sourcing.tag}</span>
        <h2 id="sourcing-heading-ar">{h.sourcing.title}</h2>
        <p>{h.sourcing.desc}</p>
        <a href={url('/global-sourcing/')} class="btn-copper" id="learn-more-btn-ar">
          {h.sourcing.cta} ←
        </a>
      </div>
      <div class="presence-content">
        <div class="presence-title">{h.presence.title}</div>
        <div class="presence-list">
          {h.presence.locations.map((loc, i) => (
            <div class="presence-item" id={`presence-ar-${i}`}>
              <div class="pi-icon">{loc.icon}</div>
              <span>{loc.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Base>
