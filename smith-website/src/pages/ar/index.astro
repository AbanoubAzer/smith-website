---
// src/pages/ar/index.astro — Arabic Home Page
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLang } from '../../i18n/translations';
import { url } from '../../utils/paths';

const lang = 'ar';
const t = getLang(lang);
const h = t.home;
const b = t.brand;

const heroSlides = [
  {
    img: url('/images/mockup-assets/cta-ship-bg.jpg'),
    alt: 'التوريد العالمي ومواد البناء والشحن الدولي',
    tagline: 'شريكك الموثوق في',
    headline: 'التوريد العالمي،\nمواد البناء و\nالشحن الدولي',
    desc: 'نربط مواد البناء عالية الجودة والمنتجات المعمارية والمصانع المعتمدة بالعملاء والمقاولين والشركات في الولايات المتحدة والأسواق الدولية.',
  },
  {
    img: url('/images/doors/entrance/luxury-modern.jpg'),
    alt: 'أبواب المداخل الفاخرة وأنظمة البيفوت',
    tagline: 'أبواب معمارية راقية',
    headline: 'أبواب المداخل الفاخرة\nوأنظمة البيفوت المحورية',
    desc: 'أبواب محورية عملاقة، أبواب ألومنيوم حرارية، وتصاميم خشبية متقنة مصممة خصيصاً للقصور والفلل والمشاريع الراقية.',
  },
  {
    img: url('/images/windows/fixed-glass-facades-and-smart-systems.jpg'),
    alt: 'أنظمة النوافذ والواجهات الزجاجية البانورامية',
    tagline: 'هندسة دقيقة وعزل متقدم',
    headline: 'نوافذ ألومنيوم متطورة\nوواجهات زجاجية بانورامية',
    desc: 'أنظمة ألومنيوم حرارية عازلة للصوت والحرارة، واجهات زجاجية وسحابات عملاقة مطابقة لأعلى المعايير والمواصفات العالمية.',
  },
  {
    img: url('/images/kitchens/european-style.jpg'),
    alt: 'مطابخ مخصصة وخزائن راقية',
    tagline: 'أناقة المساحات الداخلية',
    headline: 'مطابخ مخصصة وخزائن\nمعمارية راقية',
    desc: 'خزائن مطابخ عصرية وكلاسيكية، أسطح جزر رخامية، وحدات حمامات متكاملة ودواليب ملابس تفصيلية بأحدث الآليات العالمية.',
  },
  {
    img: url('/images/metalwork/grand-estate-gates.jpg'),
    alt: 'أعمال الحديد المطروق وبوابات القصور',
    tagline: 'حرفية يدوية وإتقان هندسي',
    headline: 'أعمال الحديد المطروق\nوبوابات القصور الملكية',
    desc: 'بوابات حديد مشغول فاخرة، درابزينات سلالم وشرفات، وأسوار حماية تجمع بين الفخامة التاريخية والصلابة العالية مع عزل ضد الصدأ.',
  },
  {
    img: url('/images/marble/calacatta-gold.jpeg'),
    alt: 'رخام طبيعي وألواح كوارتز',
    tagline: 'فخامة الأحجار الطبيعية',
    headline: 'رخام طبيعي وألواح كوارتز\nمباشرة من المصانع والمحاجر',
    desc: 'توريد مباشر لأجود أنواع الرخام الطبيعي، الكوارتز الصناعي، والجرانيت الصلب للأرضيات والمطابخ والواجهات المعمارية الفاخرة.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": h.faq.items.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Base
  lang={lang}
  title="شركة إيتكو المحدودة — التوريد العالمي، مواد البناء والشحن الدولي"
  description="نربط مواد البناء عالية الجودة والمنتجات المعمارية والمصانع المعتمدة بالعملاء والمقاولين والشركات في الولايات المتحدة والأسواق الدولية."
  canonicalUrl="https://abanoubazer.github.io/smith-website/ar/"
  keywords="مواد بناء الصين, استيراد مواد بناء من الصين, مصانع ألومنيوم الصين, أبواب خشبية ومحورية الصين, مطابخ مخصصة الصين, فحص البضائع في الصين, شحن بحري إلى أمريكا والخليج, شركة إيتكو للتجارة, EITCO Ltd"
>
  <!-- SEO FAQ JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header lang={lang} />

  <!-- 1. HERO SECTION WITH SLIDER -->
  <section class="hero-eitco" aria-label="القسم الرئيسي">
    <!-- Background Slider -->
    <div class="hero-slider">
      {heroSlides.map((slide, i) => (
        <div class={`hero-slide${i === 0 ? ' active' : ''}`} data-index={i}>
          <img src={slide.img} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <div class="hero-eitco-overlay"></div>

    <div class="container">
      <div class="hero-eitco-content">
        <div class="hero-text-slides">
          {heroSlides.map((slide, i) => (
            <div class={`hero-text-slide${i === 0 ? ' active' : ''}`} data-index={i}>
              <div class="hero-eitco-tag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                <span>{slide.tagline}</span>
              </div>
              <h1 class="hero-eitco-title">{slide.headline}</h1>
              <p class="hero-eitco-desc">{slide.desc}</p>
            </div>
          ))}
        </div>
        <div class="hero-eitco-actions">
          <a href={url('/ar/products/')} class="btn-primary" id="hero-explore-btn-ar">
            <span>{h.hero.cta1}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11H7.14l5.43-5.43L11.14 4.14 2.86 12.43l8.28 8.29 1.43-1.42L7.14 13H19v-2z"/></svg>
          </a>
          <a href={url('/ar/global-sourcing/')} class="btn-outline" id="hero-services-btn-ar">
            {h.hero.cta2}
          </a>
        </div>
      </div>
    </div>

    <!-- Hero Controls (Arrows + Dots) -->
    <div class="hero-controls">
      <button class="hero-arrow hero-arrow-prev" id="hero-prev-btn" aria-label="الشريحة السابقة">
        <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <div class="hero-dots">
        {heroSlides.map((_, i) => (
          <button class={`hero-dot${i === 0 ? ' active' : ''}`} aria-label={`الشريحة ${i + 1}`} data-index={i} />
        ))}
      </div>
      <button class="hero-arrow hero-arrow-next" id="hero-next-btn" aria-label="الشريحة التالية">
        <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  </section>

  <!-- 2. VALUE PROPOSITION BAR (5 PILLARS) -->
  <section class="pillars-bar" aria-label="ركائز خدماتنا">
    <div class="container">
      <div class="pillars-grid">
        <!-- Pillar 1: Quality Products -->
        <div class="pillar-card" id="pillar-ar-0">
          <div class="pillar-icon-wrap">
            <svg viewBox="0 0 24 24"><path d="M21 16.5C21 16.88 20.79 17.21 20.47 17.38L12.57 21.82C12.41 21.94 12.21 22 12 22C11.79 22 11.59 21.94 11.43 21.82L3.53 17.38C3.21 17.21 3 16.88 3 16.5V7.5C3 7.12 3.21 6.79 3.53 6.62L11.43 2.18C11.59 2.06 11.79 2 12 2C12.21 2 12.41 2.06 12.57 2.18L20.47 6.62C20.79 6.79 21 7.12 21 7.5V16.5M12 4.15L5.04 8.05L12 11.95L18.96 8.05L12 4.15Z"/></svg>
          </div>
          <div class="pillar-title">{h.features.items[0].title}</div>
          <div class="pillar-desc">{h.features.items[0].desc}</div>
        </div>

        <!-- Pillar 2: Global Sourcing -->
        <div class="pillar-card" id="pillar-ar-1">
          <div class="pillar-icon-wrap">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
          </div>
          <div class="pillar-title">{h.features.items[1].title}</div>
          <div class="pillar-desc">{h.features.items[1].desc}</div>
        </div>

        <!-- Pillar 3: Inspection & Documentation -->
        <div class="pillar-card" id="pillar-ar-2">
          <div class="pillar-icon-wrap">
            <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
          </div>
          <div class="pillar-title">{h.features.items[2].title}</div>
          <div class="pillar-desc">{h.features.items[2].desc}</div>
        </div>

        <!-- Pillar 4: Sea & Air Freight -->
        <div class="pillar-card" id="pillar-ar-3">
          <div class="pillar-icon-wrap">
            <svg viewBox="0 0 24 24"><path d="M20 21c-1.39 0-2.78-.47-4-1.32-2.44 1.71-5.56 1.71-8 0C6.78 20.53 5.39 21 4 21H2v2h2c1.38 0 2.74-.35 4-.99 2.52 1.29 5.48 1.29 8 0 1.26.65 2.62.99 4 .99h2v-2h-2zM3.95 19H4c1.6 0 3.02-.88 4-2 .98 1.12 2.4 2 4 2s3.02-.88 4-2c.98 1.12 2.4 2 4 2h.05l1.89-6.68c.08-.26.06-.54-.06-.78s-.33-.41-.6-.47L20 11V4c0-.55-.45-1-1-1H5c-.55 0-1 .45-1 1v7l-1.28.27c-.27.06-.48.23-.6.47s-.14.52-.06.78L3.95 19zM6 5h12v6h-3.5L12 8.5 9.5 11H6V5z"/></svg>
          </div>
          <div class="pillar-title">{h.features.items[3].title}</div>
          <div class="pillar-desc">{h.features.items[3].desc}</div>
        </div>

        <!-- Pillar 5: Local Partners -->
        <div class="pillar-card" id="pillar-ar-4">
          <div class="pillar-icon-wrap">
            <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          </div>
          <div class="pillar-title">{h.features.items[4].title}</div>
          <div class="pillar-desc">{h.features.items[4].desc}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. OUR PRODUCTS (7-CARD MOCKUP GRID) -->
  <section class="products-mockup-section" id="products" aria-labelledby="products-title-ar">
    <div class="container">
      <div class="products-mockup-header">
        <div class="products-mockup-header-text">
          <span class="section-tag">{h.products.tag}</span>
          <h2 id="products-title-ar">{h.products.title}</h2>
          <p>{h.products.desc}</p>
        </div>
        <a href={url('/ar/products/')} class="btn-primary" id="view-all-products-btn-ar">
          <span>{h.products.viewAll}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11H7.14l5.43-5.43L11.14 4.14 2.86 12.43l8.28 8.29 1.43-1.42L7.14 13H19v-2z"/></svg>
        </a>
      </div>

      <div class="products-mockup-grid">
        <!-- Top Row (3 cards): Doors, Windows, Wrought Iron -->
        <div class="prod-row-top">
          {h.products.categories.slice(0, 3).map((cat, i) => (
            <a href={cat.href} class="prod-mockup-card" id={`cat-card-ar-${i}`}>
              <img src={cat.img} alt={cat.title} loading="lazy" />
              <div class="prod-mockup-overlay">
                <div class="prod-mockup-meta">
                  <span class="prod-mockup-title">{cat.title}</span>
                  <span class="prod-mockup-arrow">←</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Bottom Row (2 cards): Kitchens & Interiors, Stone Surfaces -->
        <div class="prod-row-bottom">
          {h.products.categories.slice(3, 5).map((cat, i) => (
            <a href={cat.href} class="prod-mockup-card" id={`cat-card-ar-${i + 3}`}>
              <img src={cat.img} alt={cat.title} loading="lazy" />
              <div class="prod-mockup-overlay">
                <div class="prod-mockup-meta">
                  <span class="prod-mockup-title">{cat.title}</span>
                  <span class="prod-mockup-arrow">←</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. GLOBAL SOURCING & OUR GLOBAL PRESENCE -->
  <section class="sourcing-presence-section" id="sourcing" aria-labelledby="sourcing-title-ar">
    <div class="container">
      <div class="sourcing-presence-grid">
        <!-- Left: Sourcing Card with Inspection & Factory -->
        <div class="sourcing-banner-card" style={`background-image: url('${url('/images/mockup-assets/global-sourcing-inspection.jpg')}');`}>
          <div class="sourcing-banner-overlay"></div>
          <div class="sourcing-banner-content">
            <span class="section-tag">{h.sourcing.tag}</span>
            <h2 class="sourcing-banner-title" id="sourcing-title-ar">{h.sourcing.title}</h2>
            <p class="sourcing-banner-desc">{h.sourcing.desc}</p>
            <a href={url('/ar/global-sourcing/')} class="btn-primary" id="learn-more-sourcing-btn-ar">
              <span>{h.sourcing.cta}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11H7.14l5.43-5.43L11.14 4.14 2.86 12.43l8.28 8.29 1.43-1.42L7.14 13H19v-2z"/></svg>
            </a>
          </div>
        </div>

        <!-- Right: Our Global Presence List -->
        <div class="presence-card">
          <h3 class="presence-card-title">{h.presence.title}</h3>
          <div class="presence-list">
            {h.presence.locations.map((loc, i) => (
              <div class="presence-row" id={`presence-item-ar-${i}`}>
                <div class="presence-row-icon">
                  {loc.icon === 'building' && (
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                      <path d="M9 22v-4h6v4"/>
                      <path d="M8 6h.01M16 6h.01M12 6h.01M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01"/>
                    </svg>
                  )}
                  {loc.icon === 'pin' && (
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                  )}
                  {loc.icon === 'wrench' && (
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                    </svg>
                  )}
                  {loc.icon === 'users' && (
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                      <circle cx="9" cy="7" r="4"/>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                  )}
                </div>
                <div>
                  <div class="presence-row-name">{loc.name}</div>
                  <div class="presence-row-details">{loc.details}</div>
                  {loc.email && (
                    <div class="presence-office-links" style="margin-top:0.35rem; display:flex; flex-wrap:wrap; gap:0.75rem; font-size:0.8rem;">
                      <a href={`mailto:${loc.email}`} style="color:#0b1e36; text-decoration:none; font-weight:600; display:inline-flex; align-items:center; gap:0.35rem;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                        <span>{loc.email}</span>
                      </a>
                      {loc.whatsapp && (
                        <a href={`https://wa.me/${loc.whatsappRaw}`} target="_blank" rel="noopener noreferrer" style="color:#0b1e36; text-decoration:none; font-weight:600; display:inline-flex; align-items:center; gap:0.35rem;">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                          <span>{loc.whatsapp}</span>
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. INSIDE EITCO / OUR WORK IN ACTION -->
  <section class="media-section" id="media" aria-labelledby="media-title-ar">
    <div class="container">
      <div class="media-header">
        <div>
          <span class="section-tag">{h.media.tag}</span>
          <h2 id="media-title-ar">{h.media.title}</h2>
          <p>{h.media.desc}</p>
        </div>
        <a href={url('/ar/contact/')} class="btn-primary" id="view-media-btn-ar">
          <span>{h.media.viewAll}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11H7.14l5.43-5.43L11.14 4.14 2.86 12.43l8.28 8.29 1.43-1.42L7.14 13H19v-2z"/></svg>
        </a>
      </div>

      <div class="media-grid">
        {h.media.items.map((item, i) => (
          <a
            href={item.href}
            class="media-card"
            id={`media-item-ar-${i}`}
            data-video-trigger="true"
            data-video-title={`${item.title} — ${item.location}`}
            data-video-tag="أعمالنا في الميدان"
            data-video-desc={`لقطات وثائقية حية لعمليات ${item.title} بإشراف فريق الفحص والجودة والشحن لشركة إيتكو في ${item.location}.`}
            data-video-client="توثيق إنتاج معتمد"
            data-video-poster={item.img}
          >
            <img src={item.img} alt={item.title} loading="lazy" />
            <div class="media-card-overlay">
              <div class="media-play-pill">▶</div>
              <div class="media-info">
                <div class="media-card-title">{item.title}</div>
                <div class="media-card-location">{item.location}</div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. BUSINESS INSIGHTS / LATEST ARTICLES -->
  <section class="insights-section" id="insights" aria-labelledby="insights-title-ar">
    <div class="container">
      <div class="insights-header">
        <div>
          <span class="section-tag">{h.insights.tag}</span>
          <h2 id="insights-title-ar">{h.insights.title}</h2>
          <p>{h.insights.desc}</p>
        </div>
        <a href={url('/ar/global-sourcing/')} class="btn-primary" id="view-articles-btn-ar">
          <span>{h.insights.viewAll}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11H7.14l5.43-5.43L11.14 4.14 2.86 12.43l8.28 8.29 1.43-1.42L7.14 13H19v-2z"/></svg>
        </a>
      </div>

      <div class="insights-grid">
        {h.insights.items.map((article, i) => (
          <a href={article.href} class="article-card" id={`article-item-ar-${i}`}>
            <div class="article-thumb">
              <img src={article.img} alt={article.title} loading="lazy" />
            </div>
            <div class="article-body">
              <span class="article-tag">{article.tag}</span>
              <h3 class="article-title">{article.title}</h3>
              <span class="article-link">← قراءة الدليل</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. FREQUENTLY ASKED QUESTIONS (SEO FAQ ACCORDION) -->
  <section class="faq-section" id="faq" aria-labelledby="faq-title-ar">
    <div class="container">
      <div class="faq-header">
        <span class="section-tag">{h.faq.tag}</span>
        <h2 id="faq-title-ar">{h.faq.title}</h2>
        <p>{h.faq.desc}</p>
      </div>

      <div class="faq-list">
        {h.faq.items.map((item, i) => (
          <div class={`faq-item${i === 0 ? ' active' : ''}`} id={`faq-item-ar-${i}`}>
            <button type="button" class="faq-question-btn" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span>{item.q}</span>
              <span class="faq-toggle-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. FINAL CALL TO ACTION BANNER -->
  <section class="cta-markets-section" id="quote" aria-labelledby="cta-title-ar" style={`background-image: url('${url('/images/mockup-assets/cta-ship-bg.jpg')}');`}>
    <div class="cta-markets-overlay"></div>
    <div class="container">
      <div class="cta-col-center">
        <span class="section-tag">{h.ctaBanner.tag}</span>
        <h2 id="cta-title-ar">{h.ctaBanner.title}</h2>
        <p>{h.ctaBanner.desc}</p>
        <a href={url('/ar/contact/#quote')} class="btn-primary" id="cta-request-quote-btn-ar">
          <span>{h.ctaBanner.button}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11H7.14l5.43-5.43L11.14 4.14 2.86 12.43l8.28 8.29 1.43-1.42L7.14 13H19v-2z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- Page Interactivity Scripts -->
  <script>
    // FAQ Accordion functionality
    document.querySelectorAll('.faq-question-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const isActive = item?.classList.contains('active');
        document.querySelectorAll('.faq-item').forEach(el => el.classList.remove('active'));
        if (!isActive) {
          item?.classList.add('active');
        }
      });
    });
  </script>
</Base>
