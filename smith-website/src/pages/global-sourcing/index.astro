---
// src/pages/global-sourcing/index.astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { url } from '../../utils/paths';

const lang = 'en';
const services = [
  {
    icon: '🔍',
    title: 'Global Product Sourcing',
    desc: 'We help you find the right manufacturers and products matching your specifications, technical drawings, and target budget from China.',
    id: 'product-sourcing',
  },
  {
    icon: '🏭',
    title: 'Supplier Audits & Coordination',
    desc: 'We manage direct communication with verified factories — from initial technical inquiries to sample approval, price negotiation, and production tracking.',
    id: 'supplier-coord',
  },
  {
    icon: '🔬',
    title: 'Order Inspection & Quality Control',
    desc: 'Rigorous pre-shipment inspections covering dimensions, materials, finish tolerances, packaging, and labeling before container loading.',
    id: 'order-inspection',
  },
  {
    icon: '📋',
    title: 'Export Documentation & Customs Support',
    desc: 'Assistance with commercial invoices, packing lists, bill of lading, certificates of origin, and compliance paperwork required for customs clearance.',
    id: 'export-docs',
  },
  {
    icon: '🚢',
    title: 'Sea & Air Freight Coordination',
    desc: 'End-to-end international freight coordination (FCL & LCL container shipping, air cargo) with dependable carrier options and competitive rates.',
    id: 'freight',
  },
  {
    icon: '🔧',
    title: 'Local Handover & Partner Support',
    desc: 'Through our U.S. partner network in New Jersey, New York, and Tennessee, we coordinate local handover and installation support for eligible orders.',
    id: 'installation',
  },
];
---

<Base
  lang={lang}
  title="Global Sourcing & Trade Services — From China to Your Destination | EITCO Ltd"
  description="We source products from China, coordinate with suppliers, arrange inspections, handle export documentation, and coordinate international shipping to your destination."
  canonicalUrl="https://abanoubazer.github.io/smith-website/global-sourcing/"
>
  <Header lang={lang} />

  <div class="page-hero">
    <div class="page-hero-overlay"></div>
    <img src={url('/images/mockup-assets/sourcing-ship.jpg')} alt="Global Sourcing" />
    <div class="container">
      <div class="page-hero-content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={url('/')}>Home</a><span>›</span><span>Global Sourcing</span>
        </nav>
        <h1>Global Sourcing & Trade Services</h1>
        <p>Your Product. Our Network. From supplier selection to final delivery.</p>
      </div>
    </div>
  </div>

  <section class="section" style="background: var(--off-white);">
    <div class="container">
      <div style="text-align:center; max-width:640px; margin:0 auto 4rem;">
        <span class="section-tag">What We Do</span>
        <h2 style="font-size:clamp(1.8rem,3vw,2.4rem); margin-bottom:1rem; color:var(--navy-850);">End-to-End Sourcing Support</h2>
        <p style="color:var(--stone-600); font-size:0.95rem; line-height:1.8;">
          We source products according to your exact specifications, coordinate with trusted suppliers, and handle inspections, documentation, and international shipping — so you can focus on growing your business.
        </p>
      </div>

      <div class="services-grid">
        {services.map(svc => (
          <div class="service-card" id={`service-${svc.id}`}>
            <div class="service-icon">{svc.icon}</div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </div>
        ))}
      </div>

      <!-- Process -->
      <div class="process-section">
        <h2 style="text-align:center; margin-bottom:3rem; color:var(--navy-850);">Our 5-Step Sourcing Process</h2>
        <div class="process-steps">
          {[
            { num: '01', title: 'Share Your Requirements', desc: 'Tell us what you need — product type, dimensions, drawings, finish, quantity, target budget, and destination.' },
            { num: '02', title: 'Supplier Research & Quotation', desc: 'We evaluate suitable manufacturers from our verified network and coordinate detailed quotations and material samples.' },
            { num: '03', title: 'Order Follow-Up & Coordination', desc: 'We monitor factory production timelines, milestone schedules, and technical compliance.' },
            { num: '04', title: 'Pre-Shipment Inspection', desc: 'Quality control inspectors verify dimensions, finish, quantity, packaging, and crate labeling before release.' },
            { num: '05', title: 'Export, Shipping & Handover', desc: 'We assist with customs paperwork, coordinate ocean/air freight, and coordinate with our U.S. partner network for eligible orders.' },
          ].map((step, i) => (
            <div class="process-step" id={`step-${i}`}>
              <div class="step-num">{step.num}</div>
              <div class="step-content">
                <h4>{step.title}</h4>
                <p>{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-banner" style="margin-top:0;">
        <div class="cta-banner-content">
          <h2>Ready to start sourcing from China?</h2>
          <p>Share your product requirements and specifications with our team and we'll get back to you within 24 hours.</p>
        </div>
        <a href={url('/contact/')} class="btn-primary" id="start-sourcing-btn">
          <span>Start Your Sourcing Request</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42L16.86 11H5v2z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Base>

<style>
.page-hero { position: relative; height: 300px; overflow: hidden; display: flex; align-items: flex-end; }
.page-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.page-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(7, 21, 38, 0.9) 0%, rgba(7, 21, 38, 0.4) 100%); z-index: 1; }
.page-hero .container { position: relative; z-index: 2; padding-bottom: 2.5rem; width: 100%; }
.page-hero-content h1 { font-size: clamp(1.8rem,3.5vw,2.6rem); color: var(--white); margin-bottom: 0.4rem; }
.page-hero-content p { color: rgba(255,255,255,0.75); }
.breadcrumb { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; font-size: 0.8rem; color: rgba(255,255,255,0.65); }
.breadcrumb a { color: var(--gold-400); }

.services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 5rem; }
.service-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 2.25rem;
  box-shadow: var(--shadow-card);
  border: 1px solid #e2e8f0;
  transition: transform var(--transition), box-shadow var(--transition);
}
.service-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-deep); }
.service-icon { font-size: 2.2rem; margin-bottom: 1.25rem; }
.service-card h3 { font-size: 1.15rem; color: var(--navy-850); margin-bottom: 0.75rem; }
.service-card p { font-size: 0.88rem; color: var(--stone-600); line-height: 1.7; }

.process-section {
  background: #ffffff;
  border-radius: var(--radius-xl);
  padding: 4rem 3rem;
  margin-bottom: 5rem;
  box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  border: 1px solid #e2e8f0;
}
.process-steps { display: flex; flex-direction: column; gap: 1.5rem; max-width: 800px; margin: 0 auto; }
.process-step { display: flex; gap: 2rem; align-items: flex-start; padding-bottom: 1.5rem; border-bottom: 1px solid #e2e8f0; }
.process-step:last-child { border: none; padding-bottom: 0; }
.step-num {
  font-size: 2rem;
  font-weight: 800;
  color: var(--gold-400);
  line-height: 1;
  flex-shrink: 0;
  width: 50px;
}
.step-content h4 { font-size: 1.1rem; color: var(--navy-850); margin-bottom: 0.4rem; }
.step-content p { font-size: 0.88rem; color: var(--stone-600); line-height: 1.6; }

.cta-banner {
  background: #0b1e36;
  border-radius: var(--radius-lg);
  padding: 3rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}
.cta-banner-content h2 { font-size: 1.6rem; color: var(--white); margin-bottom: 0.4rem; }
.cta-banner-content p { font-size: 0.9rem; color: #cbd5e1; max-width: 540px; }

@media (max-width: 900px) {
  .services-grid { grid-template-columns: repeat(2, 1fr); }
  .process-section { padding: 2.5rem 1.5rem; }
}
@media (max-width: 600px) {
  .services-grid { grid-template-columns: 1fr; }
  .process-step { gap: 1rem; }
  .cta-banner { flex-direction: column; text-align: center; padding: 2rem; }
}
</style>
