---
// src/pages/index.astro — English Home Page
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang } from '../i18n/translations';
import { url } from '../utils/paths';

const lang = 'en';
const t = getLang(lang);
const h = t.home;

const heroSlides = [
  {
    img: url('/images/doors/entrance door.jpg'),
    alt: 'Luxury Entrance Doors',
    tagline: 'YOUR GLOBAL PARTNER IN',
    headline: 'Architectural Products & Trade Solutions',
    desc: 'We connect quality building materials and architectural products with customers, contractors, builders, and businesses across the United States and international markets.',
  },
  {
    img: url('/images/windows/1.jpg'),
    alt: 'Premium Aluminum Windows',
    tagline: 'ENGINEERED EXCELLENCE',
    headline: 'High-Performance Windows & Aluminum',
    desc: 'Precision thermal break windows, panoramic sliding systems, and architectural facades engineered to meet high international building codes.',
  },
  {
    img: url('/images/metalwork/full-facade.png'),
    alt: 'Wrought Iron Metalwork',
    tagline: 'ARTISAN CRAFTSMANSHIP',
    headline: 'Custom Wrought Iron & Ornamental Metal',
    desc: 'Bespoke grand entrance gates, decorative balcony railings, fences, and customized steel structures tailored to luxury residential and commercial projects.',
  },
  {
    img: url('/images/kitchens/Kitchen 1.png'),
    alt: 'Custom Kitchen Cabinets',
    tagline: 'BESPOKE LIVING SPACES',
    headline: 'Luxury Custom Kitchens & Interior Millwork',
    desc: 'Modern and classic kitchen cabinetry, premium bathroom vanities, and custom walk-in closets built with fine craftsmanship and durable hardware.',
  },
  {
    img: url('/images/marble/M 1.jpg'),
    alt: 'Premium Marble & Stone',
    tagline: 'FINE NATURAL SURFACES',
    headline: 'Direct Quarry Marble, Granite & Stone',
    desc: 'Exquisite natural stone slabs, engineered quartz countertops, and architectural stone surfaces sourced directly from premium global quarries.',
  },
];
---

<Base
  lang={lang}
  title="SMITH Co. LTD — Architectural Products & Global Trade Solutions"
  description="We connect quality building materials and architectural products with customers across the United States and international markets. Doors, Windows, Kitchens, Marble, and more."
  canonicalUrl="https://smithcoltd.com/"
>
  <Header lang={lang} />

  <!-- HERO -->
  <section class="hero" aria-label="Hero">
    <div class="hero-slider">
      {heroSlides.map((slide, i) => (
        <div class={`hero-slide${i === 0 ? ' active' : ''}`}>
          <img src={slide.img} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <div class="hero-overlay"></div>

    <!-- Navigation Arrows -->
    <button class="hero-arrow hero-arrow-prev" id="hero-prev-btn" aria-label="Previous Slide">
      <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
    </button>
    <button class="hero-arrow hero-arrow-next" id="hero-next-btn" aria-label="Next Slide">
      <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
    </button>

    <div class="container">
      <div class="hero-content">
        <div class="hero-text-slides">
          {heroSlides.map((slide, i) => (
            <div class={`hero-text-slide${i === 0 ? ' active' : ''}`} data-index={i}>
              <p class="hero-tagline">{slide.tagline}</p>
              <h1 class="hero-title">{slide.headline}</h1>
              <p class="hero-desc">{slide.desc}</p>
            </div>
          ))}
        </div>
        <div class="hero-ctas">
          <a href={url('/products/')} class="btn-primary" id="hero-explore-btn">
            {h.hero.cta1} →
          </a>
          <a href={url('/contact/')} class="btn-outline" id="hero-quote-btn">
            {h.hero.cta2}
          </a>
        </div>
      </div>
    </div>
    <div class="hero-dots">
      {heroSlides.map((_, i) => (
        <button class={`hero-dot${i === 0 ? ' active' : ''}`} aria-label={`Slide ${i + 1}`} />
      ))}
    </div>
  </section>

  <!-- FEATURES BAR -->
  <section class="features-bar" aria-label="Key Features">
    <div class="container">
      <div class="features-grid">
        {h.features.items.map((feat, i) => (
          <div class="feature-item" id={`feature-${i}`}>
            <span class="feature-icon">{feat.icon}</span>
            <div class="feature-title">{feat.title}</div>
            <div class="feature-desc">{feat.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS SHOWCASE -->
  <section class="products-section" aria-labelledby="products-heading">
    <div class="container">
      <div class="products-layout">
        <!-- Sidebar -->
        <div class="products-sidebar">
          <span class="section-tag">{h.products.tag}</span>
          <h2 id="products-heading">{h.products.title}</h2>
          <p>{h.products.desc}</p>
          <a href={url('/products/')} class="btn-secondary" id="view-all-products-btn">
            {h.products.viewAll} →
          </a>
        </div>

        <!-- Product Cards Grid -->
        <div class="products-grid">
          {h.products.categories.map((cat, i) => (
            <a href={url(cat.href)} class="product-card" id={`product-card-${i}`} aria-label={cat.title}>
              <img src={url(cat.img)} alt={cat.title} loading="lazy" />
              <div class="product-card-overlay">
                <div class="product-card-title">
                  {cat.title}
                  <span class="arrow">→</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- GLOBAL SOURCING + PRESENCE -->
  <section class="sourcing-section" aria-labelledby="sourcing-heading">
    <div class="sourcing-layout">
      <!-- Ship image -->
      <div class="sourcing-image">
        <img src={url('/images/metalwork/gate-1.jpg')} alt="Global Shipping" loading="lazy" />
      </div>

      <!-- Content -->
      <div class="sourcing-content">
        <span class="section-tag">{h.sourcing.tag}</span>
        <h2 id="sourcing-heading">{h.sourcing.title}</h2>
        <p>{h.sourcing.desc}</p>
        <a href={url('/global-sourcing/')} class="btn-copper" id="learn-more-btn">
          {h.sourcing.cta} →
        </a>
      </div>

      <!-- Global Presence -->
      <div class="presence-content">
        <div class="presence-title">{h.presence.title}</div>
        <div class="presence-list">
          {h.presence.locations.map((loc, i) => (
            <div class="presence-item" id={`presence-${i}`}>
              <div class="pi-icon">{loc.icon}</div>
              <span>{loc.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Base>
