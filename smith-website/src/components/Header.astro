---
// src/components/Header.astro
import type { Lang } from '../i18n/translations';
import { getLang } from '../i18n/translations';
import { url } from '../utils/paths';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getLang(lang);
const isRtl = lang === 'ar';
const altLang = lang === 'en' ? 'AR | العربية' : 'EN | English';
const altHref = lang === 'en' ? url('/ar/') : url('/');
---

<!-- TOP BAR -->
<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <span>Global Sourcing</span>
      <div class="sep"></div>
      <span>Building Materials</span>
      <div class="sep"></div>
      <span>Architectural Products</span>
    </div>
    <div class="topbar-right">
      <a href="https://www.google.com/maps" target="_blank" rel="noopener">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        China · New Jersey · Kuwait
      </a>
      <a href={altHref} class="lang-switcher" id="lang-switch-btn">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        {altLang}
      </a>
    </div>
  </div>
</div>

<!-- HEADER -->
<header class="header" id="main-header">
  <div class="container">
    <!-- Logo -->
    <a href={lang === 'en' ? url('/') : url('/ar/')} class="logo" id="site-logo">
      <img src={url('/images/logo/logo.png')} alt="SMITH Co. LTD Logo" width="48" height="48" />
    </a>

    <!-- Nav Links -->
    <nav class="nav-links" id="nav-links" aria-label="Main navigation">

      <!-- Home -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/') : url('/ar/')} class="nav-link" id="nav-home">{t.nav.home}</a>
      </div>

      <!-- Products MEGA MENU -->
      <div class="nav-item" id="nav-products-item">
        <a href={lang === 'en' ? url('/products/') : url('/ar/products/')} class="nav-link" id="nav-products">
          {t.nav.products}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
        </a>
        <div class="mega-menu" id="mega-menu-products">
          <!-- Column 1: Doors + Garage -->
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.doors.title}</div>
            {t.megaMenu.doors.items.map(item => (
              <a href={url(item.href)}>{item.label}</a>
            ))}
          </div>
          <!-- Column 2: Windows + Outdoor -->
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.windows.title}</div>
            {t.megaMenu.windows.items.map(item => (
              <a href={url(item.href)}>{item.label}</a>
            ))}
            <div class="mega-col-title" style="margin-top:1rem">{t.megaMenu.outdoor.title}</div>
            {t.megaMenu.outdoor.items.map(item => (
              <a href={url(item.href)}>{item.label}</a>
            ))}
          </div>
          <!-- Column 3: Metalwork -->
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.metalwork.title}</div>
            {t.megaMenu.metalwork.items.map(item => (
              <a href={url(item.href)}>{item.label}</a>
            ))}
          </div>
          <!-- Column 4: Kitchens -->
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.kitchens.title}</div>
            {t.megaMenu.kitchens.items.map(item => (
              <a href={url(item.href)}>{item.label}</a>
            ))}
          </div>
          <!-- Column 5: Stone -->
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.stone.title}</div>
            {t.megaMenu.stone.items.map(item => (
              <a href={url(item.href)}>{item.label}</a>
            ))}
          </div>
        </div>
      </div>

      <!-- Global Sourcing -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/global-sourcing/') : url('/ar/global-sourcing/')} class="nav-link" id="nav-sourcing">{t.nav.globalSourcing}</a>
      </div>

      <!-- Our Network -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/our-network/') : url('/ar/our-network/')} class="nav-link" id="nav-network">{t.nav.ourNetwork}</a>
      </div>

      <!-- About -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/about/') : url('/ar/about/')} class="nav-link" id="nav-about">{t.nav.aboutUs}</a>
      </div>

      <!-- Contact -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/contact/') : url('/ar/contact/')} class="nav-link" id="nav-contact">{t.nav.contactUs}</a>
      </div>
    </nav>

    <!-- Actions -->
    <div class="header-actions">
      <a href={lang === 'en' ? url('/contact/#quote') : url('/ar/contact/#quote')} class="btn-quote" id="header-quote-btn">
        {t.nav.requestQuote}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </a>
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  /* Mega menu wider for 5 columns */
  #mega-menu-products {
    grid-template-columns: repeat(5, 1fr);
    width: 920px;
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
  }
  .nav-item:hover #mega-menu-products {
    transform: translateX(-50%) translateY(0);
  }
  @media (max-width: 1200px) {
    #mega-menu-products { width: 700px; grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    #mega-menu-products {
      position: static !important;
      transform: none !important;
      left: auto !important;
      right: auto !important;
      width: 100% !important;
      grid-template-columns: 1fr !important;
      box-shadow: none !important;
      border: none !important;
      max-width: 100% !important;
    }
  }
</style>
