---
// src/components/Header.astro
import type { Lang } from '../i18n/translations';
import { getLang } from '../i18n/translations';
import { url } from '../utils/paths';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getLang(lang);
const isRtl = lang === 'ar';
const altLang = lang === 'en' ? 'العربية | AR' : 'English | EN';
const altHref = lang === 'en' ? url('/ar/') : url('/');
---

<!-- TOP BAR -->
<div class="topbar">
  <div class="container topbar-container">
    <div class="topbar-left">
      <a href={`mailto:${t.brand.email}`} class="topbar-item topbar-link topbar-email">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        <span>{t.brand.email}</span>
      </a>
      <span class="topbar-sep topbar-email-sep">•</span>
      <a href={`https://wa.me/${t.brand.whatsappRaw}`} target="_blank" rel="noopener noreferrer" class="topbar-item topbar-link">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span>{t.brand.whatsapp}</span>
      </a>
      <span class="topbar-sep hide-mobile">•</span>
      <span class="topbar-item topbar-slogan hide-mobile">{t.brand.slogan}</span>
    </div>

    <div class="topbar-right">
      <span class="topbar-item topbar-hubs hide-mobile">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        {t.brand.hubs}
      </span>
      <span class="topbar-sep hide-mobile">•</span>
      <a href={altHref} class="lang-switcher" id="lang-switch-btn" aria-label="Switch Language">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        <span>{altLang}</span>
      </a>
    </div>
  </div>
</div>

<!-- MAIN HEADER -->
<header class="header" id="main-header">
  <div class="container header-container">
    <!-- Brand Logo -->
    <a href={lang === 'en' ? url('/') : url('/ar/')} class="brand-logo" id="site-logo">
      <img
        src={url('/images/logo/globe-emblem-transparent.png')}
        alt="EITCO Globe"
        width="46"
        height="46"
        class="brand-emblem"
      />
      <div class="brand-text">
        <span class="brand-title">{t.brand.name}</span>
        <span class="brand-subtitle">{t.brand.tagline}</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="nav-links" id="nav-links" aria-label="Main navigation">
      <!-- Home -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/') : url('/ar/')} class="nav-link" id="nav-home">{t.nav.home}</a>
      </div>

      <!-- Products Mega Menu -->
      <div class="nav-item has-dropdown" id="nav-products-item">
        <a href={lang === 'en' ? url('/products/') : url('/ar/#products')} class="nav-link" id="nav-products">
          <span>{t.nav.products}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
        </a>
        <div class="mega-menu" id="mega-menu-products">
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.doors.title}</div>
            {t.megaMenu.doors.items.map(item => (
              <a href={item.href} class="mega-link">{item.label}</a>
            ))}
          </div>
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.windows.title}</div>
            {t.megaMenu.windows.items.map(item => (
              <a href={item.href} class="mega-link">{item.label}</a>
            ))}
          </div>
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.outdoor.title}</div>
            {t.megaMenu.outdoor.items.map(item => (
              <a href={item.href} class="mega-link">{item.label}</a>
            ))}
          </div>
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.metalwork.title}</div>
            {t.megaMenu.metalwork.items.map(item => (
              <a href={item.href} class="mega-link">{item.label}</a>
            ))}
          </div>
          <div class="mega-col">
            <div class="mega-col-title">{t.megaMenu.kitchens.title}</div>
            {t.megaMenu.kitchens.items.map(item => (
              <a href={item.href} class="mega-link">{item.label}</a>
            ))}
            <div class="mega-col-title" style="margin-top:1rem">{t.megaMenu.stone.title}</div>
            {t.megaMenu.stone.items.map(item => (
              <a href={item.href} class="mega-link">{item.label}</a>
            ))}
          </div>
        </div>
      </div>

      <!-- Services & Sourcing Dropdown -->
      <div class="nav-item has-dropdown" id="nav-services-item">
        <a href={lang === 'en' ? url('/global-sourcing/') : url('/ar/#sourcing')} class="nav-link" id="nav-services">
          <span>{t.nav.services}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
        </a>
        <div class="dropdown-menu" id="dropdown-menu-services">
          <a href={lang === 'en' ? url('/global-sourcing/') : url('/ar/#sourcing')} class="dropdown-link">
            <span class="dropdown-icon">🌐</span>
            <div>
              <div class="dropdown-title">{t.nav.globalSourcing}</div>
              <div class="dropdown-desc">{lang === 'en' ? 'Factory matching & custom procurement' : 'البحث عن المصانع والتوريد المباشر'}</div>
            </div>
          </a>
          <a href={lang === 'en' ? url('/global-sourcing/#order-inspection') : url('/ar/#sourcing')} class="dropdown-link">
            <span class="dropdown-icon">🛡️</span>
            <div>
              <div class="dropdown-title">{t.nav.orderInspection}</div>
              <div class="dropdown-desc">{lang === 'en' ? 'On-site audits & quality control' : 'الفحص الميداني ومراقبة الجودة'}</div>
            </div>
          </a>
          <a href={lang === 'en' ? url('/global-sourcing/#export-docs') : url('/ar/#sourcing')} class="dropdown-link">
            <span class="dropdown-icon">📋</span>
            <div>
              <div class="dropdown-title">{t.nav.exportDocs}</div>
              <div class="dropdown-desc">{lang === 'en' ? 'Customs compliance & documentation' : 'التخليص الجمركي وتجهيز المستندات'}</div>
            </div>
          </a>
          <a href={lang === 'en' ? url('/global-sourcing/#freight') : url('/ar/#sourcing')} class="dropdown-link">
            <span class="dropdown-icon">🚢</span>
            <div>
              <div class="dropdown-title">{t.nav.seaAirFreight}</div>
              <div class="dropdown-desc">{lang === 'en' ? 'FCL, LCL & international logistics' : 'الشحن البحري والجوي الدولي'}</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Projects -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/our-network/') : url('/ar/#projects')} class="nav-link" id="nav-projects">{t.nav.projects}</a>
      </div>

      <!-- Catalogs -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/#catalogs') : url('/ar/#catalogs')} class="nav-link" id="nav-catalogs">{t.nav.catalogs}</a>
      </div>

      <!-- Company Dropdown -->
      <div class="nav-item has-dropdown" id="nav-company-item">
        <a href={lang === 'en' ? url('/about/') : url('/ar/#sourcing')} class="nav-link" id="nav-company">
          <span>{t.nav.company}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
        </a>
        <div class="dropdown-menu" id="dropdown-menu-company">
          <a href={lang === 'en' ? url('/about/') : url('/ar/#sourcing')} class="dropdown-link">
            <span class="dropdown-icon">🏢</span>
            <div>
              <div class="dropdown-title">{t.nav.aboutUs}</div>
              <div class="dropdown-desc">{lang === 'en' ? 'Our story, mission & global offices' : 'عن الشركة ومكاتبنا حول العالم'}</div>
            </div>
          </a>
          <a href={lang === 'en' ? url('/#reviews') : url('/ar/#reviews')} class="dropdown-link">
            <span class="dropdown-icon">⭐</span>
            <div>
              <div class="dropdown-title">{t.nav.reviews}</div>
              <div class="dropdown-desc">{lang === 'en' ? 'Verified client feedback & videos' : 'آراء وتقييمات العملاء وتجاربهم'}</div>
            </div>
          </a>
          <a href={lang === 'en' ? url('/#media') : url('/ar/#media')} class="dropdown-link">
            <span class="dropdown-icon">🎬</span>
            <div>
              <div class="dropdown-title">{t.nav.media}</div>
              <div class="dropdown-desc">{lang === 'en' ? 'Production footage & on-site media' : 'لقطات وثائقية لعمليات الإنتاج'}</div>
            </div>
          </a>
          <a href={lang === 'en' ? url('/#insights') : url('/ar/#insights')} class="dropdown-link">
            <span class="dropdown-icon">💡</span>
            <div>
              <div class="dropdown-title">{t.nav.insights}</div>
              <div class="dropdown-desc">{lang === 'en' ? 'Industry news & sourcing guides' : 'دليل الاستيراد والمقالات الفنية'}</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Contact Us -->
      <div class="nav-item">
        <a href={lang === 'en' ? url('/contact/') : url('/ar/#quote')} class="nav-link" id="nav-contact">{t.nav.contactUs}</a>
      </div>

      <!-- Mobile Drawer Quote CTA -->
      <div class="nav-drawer-quote">
        <a href={lang === 'en' ? url('/contact/#quote') : url('/ar/#quote')} class="btn-primary" id="drawer-quote-btn" style="width: 100%; justify-content: center;">
          <span>{t.nav.requestQuote}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42L16.86 11H5v2z"/></svg>
        </a>
      </div>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Quote CTA Button -->
      <a href={lang === 'en' ? url('/contact/#quote') : url('/ar/#quote')} class="btn-quote-header" id="header-quote-btn">
        <span>{t.nav.requestQuote}</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42L16.86 11H5v2z"/></svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
/* Topbar */
.topbar {
  background: #071526;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 0.76rem;
  color: #94a3b8;
  height: 38px;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 102;
}
.topbar-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.topbar-left, .topbar-right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.topbar-item {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: #cbd5e1;
}
.topbar-link {
  transition: color 0.2s ease;
  text-decoration: none;
}
.topbar-link:hover {
  color: #d4a843;
}
.topbar-sep {
  color: rgba(255, 255, 255, 0.2);
}
.topbar-slogan {
  color: #94a3b8;
  font-weight: 500;
}
.lang-switcher {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.08);
  color: #f1f5f9;
  font-weight: 600;
  font-size: 0.74rem;
  transition: all 0.2s ease;
  text-decoration: none;
}
.lang-switcher:hover {
  background: #d4a843;
  color: #0b1a2d;
}

/* Header */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #0b1e36;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  transition: background 0.3s ease, box-shadow 0.3s ease;
}
.header.scrolled {
  background: rgba(11, 30, 54, 0.98);
  backdrop-filter: blur(12px);
}
.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
  gap: 1.5rem;
}

/* Brand Logo */
.brand-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  flex-shrink: 0;
}
.brand-emblem {
  width: 44px;
  height: 44px;
  object-fit: contain;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.25));
}
.brand-text {
  display: flex;
  flex-direction: column;
}
.brand-title {
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #ffffff;
  line-height: 1.1;
}
.brand-subtitle {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #d4a843;
  text-transform: uppercase;
  margin-top: 2px;
}

/* Nav Links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}
.nav-item {
  position: relative;
}
.nav-link {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.55rem 0.8rem;
  font-size: 0.94rem;
  font-weight: 600;
  color: #e2e8f0;
  text-decoration: none;
  border-radius: 6px;
  transition: color 0.2s ease, background 0.2s ease;
  white-space: nowrap;
}
.nav-link:hover, .nav-link.active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.08);
}
.nav-link svg {
  transition: transform 0.2s ease;
}
.nav-item:hover .nav-link svg {
  transform: rotate(180deg);
}

/* Mega Menu */
.mega-menu {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  background: #0f233d;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4);
  padding: 1.75rem;
  display: grid;
  grid-template-columns: repeat(5, 170px);
  gap: 1.5rem;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 110;
}
.nav-item:hover .mega-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}
.mega-col-title {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #d4a843;
  margin-bottom: 0.75rem;
  padding-bottom: 0.35rem;
  border-bottom: 1px solid rgba(212, 168, 67, 0.2);
}
.mega-link {
  display: block;
  font-size: 0.8rem;
  color: #cbd5e1;
  padding: 0.35rem 0;
  text-decoration: none;
  transition: color 0.2s ease, transform 0.2s ease;
}
.mega-link:hover {
  color: #ffffff;
  transform: translateX(4px);
}
:global(body.rtl) .mega-link:hover {
  transform: translateX(-4px);
}

/* Standard Dropdown Menu */
.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 290px;
  background: #0f233d;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  padding: 0.6rem;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(8px);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 110;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
:global(body.rtl) .dropdown-menu {
  left: auto;
  right: 0;
}
.nav-item:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0);
}
.dropdown-link {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.65rem 0.8rem;
  border-radius: 8px;
  text-decoration: none;
  transition: all 0.2s ease;
}
.dropdown-link:hover {
  background: rgba(255, 255, 255, 0.08);
  transform: translateX(4px);
}
:global(body.rtl) .dropdown-link:hover {
  transform: translateX(-4px);
}
.dropdown-icon {
  font-size: 1.15rem;
  line-height: 1.2;
  flex-shrink: 0;
}
.dropdown-title {
  font-size: 0.84rem;
  font-weight: 700;
  color: #f1f5f9;
  line-height: 1.25;
  transition: color 0.2s ease;
}
.dropdown-desc {
  font-size: 0.72rem;
  color: #94a3b8;
  margin-top: 2px;
  line-height: 1.3;
}
.dropdown-link:hover .dropdown-title {
  color: #d4a843;
}

/* Actions */
.header-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.btn-quote-header {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.58rem 1.25rem;
  background: linear-gradient(135deg, #d4a843 0%, #b88a24 100%);
  color: #0b1a2d;
  font-size: 0.88rem;
  font-weight: 700;
  border-radius: 50px;
  text-decoration: none;
  box-shadow: 0 4px 14px rgba(212, 168, 67, 0.35);
  transition: all 0.25s ease;
  white-space: nowrap;
}
.btn-quote-header:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(212, 168, 67, 0.5);
  background: linear-gradient(135deg, #e5c36f 0%, #c2932c 100%);
}

/* Mobile Toggle */
.mobile-toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 38px;
  height: 38px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  border: none;
  padding: 8px;
  cursor: pointer;
}
.mobile-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background: #ffffff;
  border-radius: 2px;
  transition: all 0.3s ease;
}

@media (max-width: 1200px) {
  .nav-link {
    padding: 0.5rem 0.65rem;
    font-size: 0.88rem;
  }
  .mega-menu {
    grid-template-columns: repeat(3, 180px);
  }
}

@media (max-width: 1024px) {
  .hide-mobile {
    display: none !important;
  }
  .mobile-toggle {
    display: flex;
  }
  .nav-links {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    background: #0b1e36;
    flex-direction: column;
    align-items: stretch;
    padding: 1.5rem;
    gap: 0.5rem;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    z-index: 99;
  }
  .nav-links .nav-link {
    font-size: 1.05rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    width: 100%;
    justify-content: space-between;
  }
  :global(body.rtl) .nav-links {
