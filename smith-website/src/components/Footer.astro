---
// src/components/Footer.astro
import type { Lang } from '../i18n/translations';
import { getLang } from '../i18n/translations';
import { url } from '../utils/paths';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getLang(lang);
const b = t.brand;
---

<!-- MAIN FOOTER -->
<footer class="main-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Story -->
      <div class="footer-brand">
        <a href={url(lang === 'en' ? '/' : '/ar/')} class="footer-logo-wrap" id="footer-logo-link">
          <img
            src={url('/images/logo/globe-emblem-transparent.png')}
            alt="EITCO Globe"
            width="48"
            height="48"
            class="footer-emblem"
          />
          <div class="footer-brand-title">
            <span class="brand-name">{b.name}</span>
            <span class="brand-sub">{b.tagline}</span>
          </div>
        </a>
        <p class="footer-desc">
          {lang === 'en'
            ? 'A global trading company connecting architectural products, premium building materials, and dependable manufacturers with clients and contractors across the United States and international markets.'
            : 'شركة تجارة دولية متخصصة في توريد المنتجات المعمارية، مواد البناء وحلول الشحن الدولي للمشاريع السكنية والتجارية في الولايات المتحدة والأسواق العالمية.'}
        </p>

        <!-- Social Media & Contact Links (Temporarily commented out until official links are provided)
        <div class="footer-social-links" id="footer-social-bar">
          <a href={`https://wa.me/${b.whatsappRaw}`} class="footer-social-btn social-wa" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Business">
            <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <a href={`mailto:${b.email}`} class="footer-social-btn social-email" aria-label="Email Us">
            <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </a>
          <a href="https://www.linkedin.com" class="footer-social-btn" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          </a>
          <a href="https://www.instagram.com" class="footer-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.facebook.com" class="footer-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
        -->
      </div>

      <!-- Architectural Products -->
      <div class="footer-col">
        <div class="footer-col-title">{lang === 'en' ? 'Architectural Products' : 'المنتجات المعمارية'}</div>
        <ul>
          <li><a href={url(lang === 'en' ? '/products/#cat-doors' : '/ar/products/#cat-doors')}>{lang === 'en' ? 'Doors' : 'الأبواب'}</a></li>
          <li><a href={url(lang === 'en' ? '/products/#cat-windows' : '/ar/products/#cat-windows')}>{lang === 'en' ? 'Windows & Aluminum' : 'النوافذ والألومنيوم'}</a></li>
          <li><a href={url(lang === 'en' ? '/products/#cat-outdoor' : '/ar/products/#cat-outdoor')}>{lang === 'en' ? 'Pergolas & Sunrooms' : 'البرجولات والغرف الشمسية'}</a></li>
          <li><a href={url(lang === 'en' ? '/products/#cat-metalwork' : '/ar/products/#cat-metalwork')}>{lang === 'en' ? 'Wrought Iron & Metalwork' : 'الحديد المطروق والمعادن'}</a></li>
          <li><a href={url(lang === 'en' ? '/products/#cat-kitchens' : '/ar/products/#cat-kitchens')}>{lang === 'en' ? 'Kitchens & Interiors' : 'المطابخ والديكور الداخلي'}</a></li>
          <li><a href={url(lang === 'en' ? '/products/#cat-stone' : '/ar/products/#cat-stone')}>{lang === 'en' ? 'Stone Surfaces' : 'الأسطح الحجرية'}</a></li>
          <li><a href={url(lang === 'en' ? '/#catalogs' : '/ar/#catalogs')}>{lang === 'en' ? 'Product Catalogs (PDF)' : 'كتالوجات المنتجات (PDF)'}</a></li>
        </ul>
      </div>

      <!-- Sourcing & Shipping -->
      <div class="footer-col">
        <div class="footer-col-title">{lang === 'en' ? 'Sourcing & Shipping' : 'التوريد والشحن'}</div>
        <ul>
          <li><a href={url(lang === 'en' ? '/global-sourcing/' : '/ar/global-sourcing/')}>{lang === 'en' ? 'Global Sourcing' : 'التوريد العالمي'}</a></li>
          <li><a href={url(lang === 'en' ? '/global-sourcing/#order-inspection' : '/ar/global-sourcing/#order-inspection')}>{lang === 'en' ? 'Order Inspection' : 'فحص الطلبات والجودة'}</a></li>
          <li><a href={url(lang === 'en' ? '/global-sourcing/#export-docs' : '/ar/global-sourcing/#export-docs')}>{lang === 'en' ? 'Export & Customs' : 'التصدير والجمارك'}</a></li>
          <li><a href={url(lang === 'en' ? '/global-sourcing/#freight' : '/ar/global-sourcing/#freight')}>{lang === 'en' ? 'Sea & Air Freight' : 'الشحن البحري والجوي'}</a></li>
          <li><a href={url(lang === 'en' ? '/our-network/' : '/ar/our-network/')}>{lang === 'en' ? 'Our Network' : 'شبكتنا ومشاريعنا'}</a></li>
          <li><a href={url(lang === 'en' ? '/about/' : '/ar/about/')}>{lang === 'en' ? 'About EITCO' : 'عن شركة إيتكو'}</a></li>
        </ul>
      </div>

      <!-- Contact & Office Locations -->
      <div class="footer-col">
        <div class="footer-col-title">{lang === 'en' ? 'Global Locations' : 'مواقعنا العالمية'}</div>
        <div class="footer-contact-item">
          <span class="f-icon">🏢</span>
          <div>
            <strong>{lang === 'en' ? 'China — Company Office' : 'الصين — المكتب الرئيسي'}</strong>
            <p class="f-sub-text">{b.chinaAddress}</p>
            <div class="f-office-contacts" style="margin-top:0.4rem; display:flex; flex-direction:column; gap:0.25rem; font-size:0.8rem;">
              <a href={`mailto:${b.email}`} style="color:#cbd5e1; text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem;">
                <span>✉️</span>
                <span>{b.email}</span>
              </a>
              <a href={`https://wa.me/${b.whatsappRaw}`} target="_blank" rel="noopener noreferrer" style="color:#d4a843; text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem; font-weight:600;">
                <span>💬</span>
                <span>{b.whatsapp}</span>
              </a>
            </div>
          </div>
        </div>
        <div class="footer-contact-item">
          <span class="f-icon">📍</span>
          <div>
            <strong>{lang === 'en' ? 'USA — Partner Office' : 'أمريكا — مكتب الشريك'}</strong>
            <p class="f-sub-text">
              {b.usPartnerName} ({b.usPartnerLocation})<br />
              <a href={`tel:${b.usPartnerPhone.replace(/[^0-9+]/g, '')}`} style="color:#d4a843;">{b.usPartnerPhone}</a>
            </p>
          </div>
        </div>
        <div class="footer-contact-item">
          <span class="f-icon">🏢</span>
          <div>
            <strong>{lang === 'en' ? 'Kuwait — Regional Presence' : 'الكويت — المكتب الإقليمي'}</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div class="footer-bottom-copy">
        <p>{t.footer.rights}</p>
        <span class="footer-bottom-tagline">{t.footer.partnerLine}</span>
      </div>
      <div class="footer-bottom-links">
        <a href={url(lang === 'en' ? '/contact/' : '/ar/contact/')}>{t.footer.privacy}</a>
        <a href={url(lang === 'en' ? '/contact/' : '/ar/contact/')}>{t.footer.terms}</a>
        <a href={url(lang === 'en' ? '/ar/' : '/')}>{lang === 'en' ? 'العربية' : 'English'}</a>
      </div>
    </div>
  </div>
</footer>

<style>
.main-footer {
  background: #071526;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  color: #94a3b8;
  padding: 4.5rem 0 2rem;
  font-size: 0.85rem;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr 1.1fr 1.1fr 1.6fr;
  gap: 3rem;
  margin-bottom: 3.5rem;
}
.footer-logo-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  margin-bottom: 1.25rem;
}
.footer-emblem {
  width: 44px;
  height: 44px;
  object-fit: contain;
}
.footer-brand-title {
  display: flex;
  flex-direction: column;
}
.brand-name {
  font-size: 1.25rem;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
}
.brand-sub {
  font-size: 0.7rem;
  font-weight: 600;
  color: #d4a843;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-top: 2px;
}
.footer-desc {
  font-size: 0.84rem;
  color: #94a3b8;
  line-height: 1.7;
  margin-bottom: 1.5rem;
}
.footer-social-links {
  display: flex;
  gap: 0.6rem;
  align-items: center;
}
.footer-social-btn {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #cbd5e1;
  transition: all 0.25s ease;
  text-decoration: none;
}
.footer-social-btn svg {
  width: 17px;
  height: 17px;
  fill: currentColor;
}
.footer-social-btn:hover {
  background: #d4a843;
  color: #071526;
  transform: translateY(-2px);
}
.social-wa:hover {
  background: #25d366 !important;
  color: #ffffff !important;
}

.footer-col-title {
  font-size: 0.85rem;
  font-weight: 700;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 1.25rem;
}
.footer-col ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}
.footer-col a {
  color: #94a3b8;
  text-decoration: none;
  transition: color 0.2s ease, transform 0.2s ease;
  display: inline-block;
}
.footer-col a:hover {
  color: #d4a843;
  transform: translateX(4px);
}
:global(body.rtl) .footer-col a:hover {
  transform: translateX(-4px);
}

.footer-contact-item {
  display: flex;
  gap: 0.6rem;
  align-items: flex-start;
  margin-bottom: 0.85rem;
  font-size: 0.82rem;
  line-height: 1.5;
}
.f-icon {
  font-size: 1rem;
  flex-shrink: 0;
}
.f-sub-text {
  font-size: 0.74rem;
  color: #64748b;
  margin-top: 2px;
}
.footer-email-link {
  color: #d4a843 !important;
  font-weight: 600;
}

.footer-bottom {
  padding-top: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.78rem;
  color: #64748b;
}
.footer-bottom-copy {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}
.footer-bottom-tagline {
  color: #d4a843;
  font-weight: 500;
}
.footer-bottom-links {
  display: flex;
  gap: 1.25rem;
}
.footer-bottom-links a {
  color: #64748b;
  text-decoration: none;
  transition: color 0.2s ease;
}
.footer-bottom-links a:hover {
  color: #d4a843;
}

@media (max-width: 1024px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
}
@media (max-width: 640px) {
  .footer-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
