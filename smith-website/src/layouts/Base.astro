---
// src/layouts/Base.astro
import '../styles/global.css';
import type { Lang } from '../i18n/translations';
import { url } from '../utils/paths';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { lang, title, description, ogImage = '/images/logo/logo.png', canonicalUrl } = Astro.props;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : url(ogImage);
const isRtl = lang === 'ar';
const altHref = lang === 'en' ? url('/ar/') : url('/');
const currentUrl = canonicalUrl || Astro.url.href;
---
<!doctype html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'} class:list={[isRtl && 'rtl']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={currentUrl} />

    <!-- Hreflang for bilingual -->
    <link rel="alternate" hreflang="en" href={`https://smithcoltd.com/`} />
    <link rel="alternate" hreflang="ar" href={`https://smithcoltd.com/ar/`} />
    <link rel="alternate" hreflang="x-default" href={`https://smithcoltd.com/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta property="og:site_name" content="SMITH Co. LTD" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Schema.org Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "SMITH Co. LTD",
      "url": "https://smithcoltd.com",
      "logo": "https://smithcoltd.com/images/logo/logo.png",
      "description": "Global trading company specializing in architectural products, building materials, and international sourcing solutions.",
      "areaServed": ["US", "CN", "KW", "EG", "SA"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Architectural Products & Sourcing Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Doors" } },
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Windows & Aluminum" } },
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Wrought Iron & Metalwork" } },
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Kitchens & Interiors" } },
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Stone Surfaces" } }
        ]
      }
    })} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={url('/images/logo/logo.png')} />

    <!-- Fonts preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class:list={[isRtl && 'rtl']}>
    <slot />

    <!-- WhatsApp Button -->
    <a href="https://wa.me/8617132060963" class="whatsapp-btn" target="_blank" rel="noopener noreferrer" aria-label="Contact us on WhatsApp" id="whatsapp-fab">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- Header scroll + mobile nav JS -->
    <script>
      // Header scroll effect
      const header = document.querySelector('.header') as HTMLElement;
      window.addEventListener('scroll', () => {
        header?.classList.toggle('scrolled', window.scrollY > 20);
      }, { passive: true });

      // Mobile nav toggle
      const toggle = document.getElementById('mobile-toggle');
      const navLinks = document.querySelector('.nav-links') as HTMLElement;
      toggle?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('open');
        toggle?.classList.toggle('active', isOpen);
        document.body.classList.toggle('nav-open', isOpen);
      });

      // Mobile mega menu toggle
      document.querySelectorAll('.nav-item').forEach(item => {
        const link = item.querySelector('.nav-link');
        link?.addEventListener('click', (e) => {
          if (window.innerWidth <= 768 && item.querySelector('.mega-menu')) {
            e.preventDefault();
            item.classList.toggle('open');
          }
        });
      });

      // Close menu when clicking backdrop/outside
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (window.innerWidth <= 768 && navLinks?.classList.contains('open')) {
          if (!navLinks.contains(target) && !toggle?.contains(target)) {
            navLinks.classList.remove('open');
            toggle?.classList.remove('active');
            document.body.classList.remove('nav-open');
          }
        }
      });

      // Hero slider
      const slides = document.querySelectorAll('.hero-slide');
      const dots = document.querySelectorAll('.hero-dot');
      let current = 0;
      let interval: ReturnType<typeof setInterval>;

      function goTo(idx: number) {
        slides[current]?.classList.remove('active');
        dots[current]?.classList.remove('active');
        current = idx;
        slides[current]?.classList.add('active');
        dots[current]?.classList.add('active');
      }

      function next() { goTo((current + 1) % slides.length); }

      if (slides.length > 1) {
        interval = setInterval(next, 5000);
        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => { clearInterval(interval); goTo(i); interval = setInterval(next, 5000); });
        });
      }
    </script>
  </body>
</html>
