---
// src/layouts/Base.astro
import '../styles/global.css';
import type { Lang } from '../i18n/translations';
import { url } from '../utils/paths';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  keywords?: string;
}

const {
  lang,
  title,
  description,
  ogImage = '/images/logo/elena-logo-full.png',
  canonicalUrl,
  keywords = lang === 'ar'
    ? 'توريد مواد بناء من الصين, منتجات معمارية الصين, استيراد أبواب ونوافذ من الصين, شحن من الصين الى امريكا, فحص جودة المصانع في الصين, شركة إلينا للتجارة الدولية, شركة إيتكو, حديد مطروق رخام كوارتز مطابخ'
    : 'building materials from China, architectural products sourcing, doors and windows manufacturer China, importing building materials to USA, China sourcing agent Hangzhou, pre-shipment inspection China, custom kitchens China, EITCO Ltd, Elena International Trading'
} = Astro.props;

const resolvedOgImage = ogImage.startsWith('http') ? ogImage : url(ogImage);
const isRtl = lang === 'ar';
const currentUrl = canonicalUrl || Astro.url.href;
---
<!doctype html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'} class:list={[isRtl && 'rtl']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1e36" />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={currentUrl} />

    <!-- Hreflang for bilingual -->
    <link rel="alternate" hreflang="en" href="https://abanoubazer.github.io/smith-website/" />
    <link rel="alternate" hreflang="ar" href="https://abanoubazer.github.io/smith-website/ar/" />
    <link rel="alternate" hreflang="x-default" href="https://abanoubazer.github.io/smith-website/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta property="og:site_name" content="EITCO Ltd — Elena International Trading Co., Limited" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Schema.org Organization & Aggregate Rating -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://abanoubazer.github.io/smith-website/#organization",
          "name": "EITCO Ltd",
          "legalName": "Elena International Trading Co., Limited",
          "alternateName": ["شركة إلينا للتجارة الدولية المحدودة", "شركة إيتكو المحدودة"],
          "url": "https://abanoubazer.github.io/smith-website/",
          "logo": "https://abanoubazer.github.io/smith-website/images/logo/globe-emblem-transparent.png",
          "image": "https://abanoubazer.github.io/smith-website/images/logo/elena-logo-full.png",
          "description": "Global trading company specializing in architectural products, building materials, supplier audits, quality inspection, and international sea/air freight from China to the United States and global markets.",
          "areaServed": ["United States", "Kuwait", "Saudi Arabia", "United Arab Emirates", "China", "Egypt"],
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "telephone": "+86-186-1623-2842",
              "contactType": "customer service",
              "email": "eliagadallah@eit-co.com",
              "availableLanguage": ["English", "Arabic", "Chinese"]
            }
          ],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Innovation China Industrial Park, 4 Xingxian Road, Gongshu District",
            "addressLocality": "Hangzhou City",
            "addressCountry": "CN"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.9",
            "reviewCount": "48",
            "bestRating": "5",
            "worstRating": "1"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://abanoubazer.github.io/smith-website/#website",
          "url": "https://abanoubazer.github.io/smith-website/",
          "name": "EITCO Ltd",
          "publisher": {
            "@id": "https://abanoubazer.github.io/smith-website/#organization"
          },
          "inLanguage": ["en", "ar"]
        }
      ]
    })} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={url('/images/logo/globe-emblem-transparent.png')} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class:list={[isRtl && 'rtl']}>
    <slot />

    <!-- Floating WhatsApp Button -->
    <a
      href="https://wa.me/8618616232842"
      class="whatsapp-btn"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={lang === 'ar' ? 'تواصل عبر واتساب الأعمال' : 'Chat on WhatsApp Business'}
      id="whatsapp-fab"
    >
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- Universal Video Lightbox Modal -->
    <div class="video-modal-backdrop" id="universal-video-modal" role="dialog" aria-modal="true" aria-label="Video Player">
      <div class="video-modal-dialog">
        <button class="video-modal-close-btn" id="video-modal-close" aria-label="Close video">✕</button>
        <div class="video-screen-player">
          <img src={url('/images/mockup-assets/hero-bg.jpg')} alt="Video Backdrop" class="video-screen-poster" id="video-modal-poster" />
          <div class="video-live-overlay">
            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
              <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#25d366; animation:pulse 1.5s infinite;"></span>
              <span style="font-size:0.75rem; font-weight:700; color:#d4a843; text-transform:uppercase;">EITCO Media Reel</span>
            </div>
          </div>
          <div class="video-player-controls" id="dummy-play-pause-btn" title="Play / Pause video">
            <span id="play-pause-icon">▶</span>
          </div>
        </div>
        <div class="video-dialog-body">
          <div class="video-dialog-tag" id="video-modal-tag">Featured Project</div>
          <h3 class="video-dialog-title" id="video-modal-title">Project Video Walkthrough</h3>
          <p class="video-dialog-desc" id="video-modal-desc">Detailed video presentation showing on-site installation, factory auditing, and quality inspection verified by EITCO specialists.</p>
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
            <a href={lang === 'en' ? url('/contact/#quote') : url('/ar/contact/#quote')} class="btn-primary" style="padding:0.65rem 1.4rem; font-size:0.82rem;">
              <span>{lang === 'en' ? 'Inquire About This Solution' : 'طلب تسعيرة لهذا الحل'}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42L16.86 11H5v2z"/></svg>
            </a>
            <span style="font-size:0.76rem; color:#94a3b8;" id="video-modal-client">Verified Client Project</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Universal Toast Notification -->
    <div class="toast-notification" id="global-toast" role="status" aria-live="polite">
      <span style="font-size:1.1rem;">📄</span>
      <span id="toast-message">{lang === 'en' ? 'Downloading catalog...' : 'جاري تنزيل الكتالوج...'}</span>
    </div>

    <!-- Interactive Scripts -->
    <script>
      // Header scroll effect
      const header = document.querySelector('.header') as HTMLElement;
      window.addEventListener('scroll', () => {
        header?.classList.toggle('scrolled', window.scrollY > 20);
      }, { passive: true });

      // Mobile nav toggle
      const toggle = document.getElementById('mobile-toggle');
      const navLinks = document.querySelector('.nav-links') as HTMLElement;
      toggle?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('open');
        toggle?.classList.toggle('active', isOpen);
        document.body.classList.toggle('nav-open', isOpen);
      });

      // Video Modal Handlers
      const videoModal = document.getElementById('universal-video-modal');
      const videoCloseBtn = document.getElementById('video-modal-close');
      const videoTitle = document.getElementById('video-modal-title');
      const videoTag = document.getElementById('video-modal-tag');
      const videoDesc = document.getElementById('video-modal-desc');
      const videoClient = document.getElementById('video-modal-client');
      const videoPoster = document.getElementById('video-modal-poster') as HTMLImageElement;
      const playPauseBtn = document.getElementById('dummy-play-pause-btn');
      const playPauseIcon = document.getElementById('play-pause-icon');

      function openVideoModal(title: string, tag: string, desc: string, client: string, poster: string) {
        if (!videoModal) return;
        if (videoTitle) videoTitle.textContent = title;
        if (videoTag) videoTag.textContent = tag;
        if (videoDesc) videoDesc.textContent = desc;
        if (videoClient) videoClient.textContent = client;
        if (videoPoster && poster) videoPoster.src = poster;
        videoModal.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeVideoModal() {
        if (!videoModal) return;
        videoModal.classList.remove('open');
        document.body.style.overflow = '';
      }

      videoCloseBtn?.addEventListener('click', closeVideoModal);
      videoModal?.addEventListener('click', (e) => {
        if (e.target === videoModal) closeVideoModal();
      });

      // Toggle Play / Pause icon in dummy video
      let isPlaying = false;
      playPauseBtn?.addEventListener('click', () => {
        isPlaying = !isPlaying;
        if (playPauseIcon) {
          playPauseIcon.textContent = isPlaying ? '❚❚' : '▶';
        }
      });

      // Attach video triggers across page
      document.querySelectorAll('[data-video-trigger]').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const t = trigger.getAttribute('data-video-title') || 'Project Video Walkthrough';
          const tag = trigger.getAttribute('data-video-tag') || 'Verified Video';
          const desc = trigger.getAttribute('data-video-desc') || 'Live project walkthrough and manufacturing verification.';
          const client = trigger.getAttribute('data-video-client') || 'EITCO Client Case Study';
          const poster = trigger.getAttribute('data-video-poster') || '';
          openVideoModal(t, tag, desc, client, poster);
        });
      });

      // Toast notification helper
      (window as any).showToast = function(msg: string) {
        const toast = document.getElementById('global-toast');
        const toastMsg = document.getElementById('toast-message');
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
        }, 3200);
      };
    </script>
  </body>
</html>
